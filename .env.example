# Copie para .env. Os valores abaixo são os do docker-compose.yml.
DATABASE_URL=postgresql://conectores:conectores@localhost:5544/conectores
API_URL=http://localhost:8090
API_CLIENT_ID=demo
API_CLIENT_SECRET=demo-secret
EMPRESAS=rota-sul,rota-nordeste,rota-serra

# Rotina sem sucesso há mais horas que isso aparece como atrasada no `status`.
HORAS_DE_TOLERANCIA=26

# Opcional: endereço que recebe {"text": "..."} quando uma rotina falha.
ALERTA_WEBHOOK_URL=
